# ==============================================================================
# Git Ignore for Agentic Prescription Generator & Studio
# ==============================================================================

# --- Python Virtual Environments ----------------------------------------------
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
share/
pyvenv.cfg

# --- Python Bytecode, Build & Cache -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.manifest
*.spec

# --- Testing & Code Quality ---------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Node.js & Web Studio -----------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# --- Application Runtime Data & Local Databases -------------------------------
**/data/app_state.db*
*.db
*.sqlite
*.sqlite3

# Ignore generated outputs and runtime files, but keep directory structure
**/data/outputs/*
!**/data/outputs/.gitkeep
**/data/audio_files/*
!**/data/audio_files/.gitkeep
**/data/faiss_index/*
!**/data/faiss_index/.gitkeep

# Ignore audio recordings & exports placed outside data
*.wav
*.mp3
*.m4a
*.ogg
*.csv
*.xlsx
!tests/**/*.csv
!tests/**/*.xlsx

# --- Offline LLM & ASR Model Weights -----------------------------------------
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
models/
Whisper_Ayush/

# --- Environment Configurations & Secrets -------------------------------------
.env
.env.local
.env.*.local
.streamlit/secrets.toml
!.env.example

# --- IDE, Editor & OS Artifacts -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
